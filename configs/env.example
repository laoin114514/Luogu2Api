# Luogu2Api 环境变量样例
#
# 配置只来自环境变量：二进制**不读** .env（避免镜像里残留一个 .env 就把忘记配置的
# 必填项悄悄补上）。两种给法：
#
#   本地开发：cp configs/env.example configs/.env，改完用 pwsh scripts/dev.ps1 启动
#            （脚本把 .env 导出到当前会话，退出即失效；.env 已在 .gitignore 里）
#   部署：    compose 的 env_file / environment，或 k8s Secret、服务管理器的环境变量
#
# 优先级：脚本与 compose 都是"**已存在的非空环境变量优先**"——显式配置的值不会被
# 文件覆盖，文件只补空缺。
#
# 写法：支持 ` #` 开头的行内注释（# 前需要有空白）。紧贴值的 # 按字面量保留，
#      值里要含 " #" 请用引号包起来，例如 DB_PASSWORD="p@ss #1"。
#
# 必填项：DB_HOST/DB_USER/DB_NAME（号池账号存 MySQL）、ACCOUNT_SECRET_KEY（凭据加密）、
#        LUOGU_OCR_URL（自动重登依赖验证码识别）。缺失时启动即报错，不会带病运行。

# --- 应用 ---
APP_NAME=luogu2api
APP_ENV=dev                 # dev / test / prod；prod 时日志为 JSON、gin 为 release 模式
LOG_LEVEL=info              # debug / info / warn / error

# --- HTTP ---
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=10s

# --- MySQL（必填）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=luogu2api             # 只允许字母、数字、下划线、$ 与 -
DB_PARAMS=charset=utf8mb4&parseTime=True&loc=Local
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
# 库结构：模型是唯一来源，没有手写的迁移 SQL（见 internal/schema）
# 开启时服务启动会自动补齐**安全**变更（建库/建表/加列/建索引）；关闭时只校验，
# 库（或表/列）落后于代码会让启动直接失败并提示先执行：go run ./cmd/api -migrate
# 注意"建库"也在这个开关下：DSN 直接指向 DB_NAME，库不存在时连接阶段就报 1049，
# 连接账号需要 CREATE 权限；只读的 -schema-status 不会建库。
DB_MIGRATE_ON_START=true    # 本地开发建议 true
# 发现需要人工确认的差异（删列/改类型/索引变化，自动执行有丢数据风险）时拒绝启动。
# 确认这些差异可以忽略时设 false（差异仍会打进日志）。
DB_SCHEMA_STRICT=true
DB_LOG_LEVEL=warn           # silent / error / warn / info

# --- 洛谷客户端 ---
LUOGU_TIMEOUT=30s
LUOGU_RETRY=1               # SDK 内部重试次数；设为 0 时 ACCOUNT_LOGIN_MAX_ATTEMPTS 与实际请求数一一对应

# --- 验证码识别服务（必填）---
# SDK 不内置 OCR，自动重登依赖它。两种入参形态（LUOGU_OCR_MODE）：
#   base64（默认）：POST application/json  {"image_base64":"<base64 JPEG>"}
#   raw           ：POST image/jpeg        <原始图片字节>
# 响应支持 data.text / result / code / text / 纯文本；
# 例：{"sucess":true,"message":"识别成功","data":{"text":"anm"}}（sucess 是服务端拼写）
# 本地联调可用 scripts/ocr_stub.py（入参与返回都对齐现用服务）。
LUOGU_OCR_URL=https://easo.laoin.work/ocr/ocr/classify_base64
LUOGU_OCR_MODE=base64
LUOGU_OCR_TOKEN=
LUOGU_OCR_TIMEOUT=5s

# --- 账号池 ---
# 凭据加密密钥（AES-GCM，保护落库的账号密码与 cookie）。生成：
#   go run ./cmd/api -genkey     # 顺带打印一条随机 ADMIN_TOKEN；容器里用 docker compose run --rm api -genkey
#   openssl rand -base64 32      # 等价；没装 openssl（Windows 默认没有）时用上面的
# 规则：hex 或 base64 编码，解码后必须正好是 16/24/32 字节。**随手写的口令会被拒绝**——
#       它直接是 AES 密钥，放开成任意口令等于把落库凭据的强度交给运气。
# ⚠️ 这一项要**单独备份**（密码管理器 / Secret 管理器 / 离线保管）：丢了它，库里
#    accounts.password_enc / cookie_enc 就再也解不开，只能给每个账号重填一次密码；
#    恢复步骤见 README「密钥丢失与备份」。也别和数据库 dump 放在同一个备份包里。
ACCOUNT_SECRET_KEY=
ACCOUNT_SWEEP_INTERVAL=5m       # 扫描器 tick（每轮只处理到期的账号）
ACCOUNT_VERIFY_INTERVAL=30m     # 单账号多久验证一次登录态
ACCOUNT_VERIFY_JITTER=0.2       # 验证间隔抖动比例 [0,1)，避免整池同时打洛谷
ACCOUNT_VERIFY_CONCURRENCY=1    # 一轮扫描内的并发账号数（建议保持 1-2）
ACCOUNT_LOGIN_MAX_ATTEMPTS=5    # 单次重登任务的尝试次数（每次换新验证码）
ACCOUNT_LOGIN_BACKOFF=1m        # 重登失败的退避基数（指数增长）
ACCOUNT_FAILED_RETRY=1h         # relogin_failed 的慢速重试上限
ACCOUNT_REQUEST_MAX_TRY=3       # 业务请求最多换几个账号
ACCOUNT_SWEEP_BATCH_LIMIT=200   # 单轮最多处理多少个账号

# 让池内账号加入洛谷"代码公开计划"（openSource=1）。默认 false。
# 开启后由号池在"登录成功后 / 每轮验证成功后"幂等地补做：成功一次即永久跳过
# （记在 accounts.open_source_joined），失败只记日志、下轮重试，不影响账号可用性。
# 这个开关只决定"要不要写"：账号在洛谷的真实加入状态（偏好设置 openSource）每次验证
# 都会只读同步进 accounts.open_source_joined——导入一个早已加入的账号也会被如实记上。
# ⚠️ 这是不可逆动作：加入后洛谷限制 30 天内不能退出（改回 openSource=0/-1 会被拒绝），
#    且账号的代码会公开。只在明确需要时开启。
ACCOUNT_JOIN_OPEN_SOURCE=false

# --- 接口令牌（ADMIN_TOKEN）---
# /api/v1 下的**所有**接口（题目、提交记录、号池状态、管理接口）都要在请求头带
# X-Admin-Token：这是唯一的口令，没有第二个业务令牌。
# 留空 = 中间件拒绝全部 API 请求（fail closed），只剩 /healthz、/livez 两个探活
# 接口可用，因此实际部署必须设置。
# 格式没有任何要求：任意非空字符串都能用（本地开发填 dev-token 也行），只是生产别用弱口令。
# 随机值：go run ./cmd/api -genkey（或 openssl rand -hex 32）。
ADMIN_TOKEN=
