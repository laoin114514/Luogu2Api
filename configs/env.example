# Luogu2Api 环境变量样例
#
# Linux/macOS:  export KEY=VALUE
# Windows:      $env:KEY = "VALUE"      （或写进 .env 后自行加载）
#
# 说明：不设置 DB_HOST 即以「无数据库模式」启动，health 中 db 显示 disabled。

# --- 应用 ---
APP_NAME=luogu2api
APP_ENV=dev                 # dev / test / prod；prod 时日志为 JSON、gin 为 release 模式
LOG_LEVEL=info              # debug / info / warn / error

# --- HTTP ---
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=10s

# --- MySQL（全部留空 = 不启用数据库）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=luogu2api
DB_PARAMS=charset=utf8mb4&parseTime=True&loc=Local
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_AUTO_MIGRATE=true        # 仅建议开发环境开启
DB_LOG_LEVEL=warn           # silent / error / warn / info

# --- 洛谷客户端 ---
LUOGU_COOKIE_FILE=cookies.json   # 内含会话凭据，已在 .gitignore 中忽略
LUOGU_TIMEOUT=30s
